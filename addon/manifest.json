{
  "manifest_version": 3,
  "name": "TntConnect Mail Import",
  "version": "1.0.0",
  "description": "Import emails from Thunderbird into TntConnect",
  "permissions": [
    "messagesRead",
    "nativeMessaging",
    "contextMenus"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "TntConnect Mail Import"
  }
}
