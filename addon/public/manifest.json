{
  "manifest_version": 2,
  "version": "1.0.3",
  "author": "Eberhard Beilharz",
  "name": "TntConnect Mail Import",
  "description": "Import emails from Thunderbird into TntConnect",
  "browser_specific_settings": {
    "gecko": {
      "id": "ermshiperete.tntconnect-mail-import@addons.thunderbird.net"
    }
  },
  "background": {
    "scripts": ["tntConnectBackground.js"],
    "type": "module"
  },
  "permissions": [
    "accountsRead",
    "menus",
    "messagesRead",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "browser_style": true
  }
}
