{
  "name": "tntconnect-mail-import",
  "version": "1.0.0",
  "description": "Import Thunderbird emails into TntConnect",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:debug": "DEBUG=1 tsc && DEBUG=1 vite build",
    "package": "npm run build && cd dist && zip -r TntConnectMailImport.zip ./*",
    "package:debug": "npm run build:debug && cd dist && zip -r TntConnectMailImport.zip ./*",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/thunderbird-webext-browser": "^127.0.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.0",
    "typescript": "7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
